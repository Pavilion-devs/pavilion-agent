# Copy to .env and fill in. Never commit .env.

# Meterless Nightshift — from Nightshift's Console (NOT the NVIDIA key; that stays in Nightshift)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto

# Zetaris local platform
ZETARIS_URL=http://localhost:3000
ZETARIS_USER=
ZETARIS_PASSWORD=

# Contact User-Agent required by SEC EDGAR and company_dns: "app_name you@domain.tld"
SEC_USER_AGENT=

# Zetaris JDBC (official driver from the platform bundle)
ZETARIS_JDBC_JAR=../zetaris-platform/jdbc/ndp-jdbc-driver-2.4.3.1-7eff043-driver.jar
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
JAVA_HOME=/opt/homebrew/opt/openjdk@17
